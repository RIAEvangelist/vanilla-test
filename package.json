{
  "name": "vanilla-test",
  "version": "2.1.0",
  "description": "Zero-build, Web-standard JavaScript testing for Node and browsers",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "bin/",
    "lib/",
    "CHANGELOG.md",
    "MIGRATION.md"
  ],
  "bin": {
    "vanilla-test": "bin/vanilla-test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "npm run test:core && npm run test:tooling",
    "test:core": "node ./test/node.js",
    "test:tooling": "node --test ./test/tooling.js ./test/output.js ./test/server-security.js ./test/status-builder.js",
    "coverage": "node ./bin/vanilla-test.js coverage",
    "coverage:node": "node ./bin/vanilla-test.js coverage node",
    "coverage:chrome": "node ./bin/vanilla-test.js coverage chrome",
    "site:status": "node ./scripts/build-site-status.js --run-tooling",
    "screenshots": "node ./scripts/screenshots.js",
    "start": "node ./scripts/serve.js"
  },
  "keywords": [
    "test",
    "vanilla",
    "minimal",
    "node",
    "web",
    "browser",
    "es6"
  ],
  "author": "Roshi _ _",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/vanilla-test.git"
  },
  "dependencies": {
    "ansi-colors-es6": "^5.0.0",
    "strong-type": "^1.1.0"
  },
  "bugs": {
    "url": "https://github.com/RIAEvangelist/vanilla-test/issues"
  },
  "homepage": "https://riaevangelist.github.io/vanilla-test/",
  "directories": {
    "example": "example",
    "lib": "lib",
    "test": "test"
  }
}
