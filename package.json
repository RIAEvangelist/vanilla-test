{
  "name": "vanilla-test",
  "version": "2.0.0",
  "description": "Zero-build, Web-standard JavaScript testing for Node and browsers",
  "main": "index.js",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "vanilla-test": "bin/vanilla-test.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node ./test/node.js && node --test ./test/tooling.js",
    "coverage": "node ./bin/vanilla-test.js coverage",
    "coverage:node": "node ./bin/vanilla-test.js coverage node",
    "coverage:chrome": "node ./bin/vanilla-test.js coverage chrome",
    "screenshots": "node ./scripts/screenshots.js",
    "start": "node ./scripts/serve.js"
  },
  "keywords": [
    "test",
    "vanilla",
    "minimal",
    "node",
    "web",
    "browser",
    "es6"
  ],
  "author": "Brandon Nozaki Miller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RIAEvangelist/vanilla-test.git"
  },
  "dependencies": {
    "ansi-colors-es6": "^5.0.0",
    "c8": "^12.0.0",
    "monocart-coverage-reports": "^2.12.12",
    "playwright-core": "^1.62.1",
    "strong-type": "^1.1.0"
  },
  "bugs": {
    "url": "https://github.com/RIAEvangelist/vanilla-test/issues"
  },
  "homepage": "https://github.com/RIAEvangelist/vanilla-test#readme",
  "directories": {
    "example": "example",
    "lib": "lib",
    "test": "test"
  },
  "devDependencies": {}
}
